\newcommand{\ESDBadge}[3]{\begingroup\sffamily\bfseries\footnotesize\colorbox{#1}{\textcolor{#2}{\strut\,#3\,}}\endgroup}
\newcommand{\ESDStatus}[1]{%
  \ifstrequal{#1}{PASS}{\ESDBadge{ESDGreenTint}{ESDGreen}{#1}}{%
  \ifstrequal{#1}{GO}{\ESDBadge{ESDGreenTint}{ESDGreen}{#1}}{%
  \ifstrequal{#1}{FAIL}{\ESDBadge{ESDRedTint}{ESDRed}{#1}}{%
  \ifstrequal{#1}{NO-GO}{\ESDBadge{ESDRedTint}{ESDRed}{#1}}{%
  \ifstrequal{#1}{UNKNOWN}{\ESDBadge{ESDAmberTint}{ESDAmber}{#1}}{%
  \ifstrequal{#1}{CONDITIONAL}{\ESDBadge{ESDAmberTint}{ESDAmber}{#1}}{%
  \ESDBadge{ESDGrayTint}{ESDMuted}{#1}}}}}}}%
}
\newcommand{\ESDStatusConditionalGo}{\ESDBadge{ESDAmberTint}{ESDAmber}{CONDITIONAL\_GO}}
\newcommand{\ESDStatusNoGo}{\ESDBadge{ESDRedTint}{ESDRed}{NO\_GO}}


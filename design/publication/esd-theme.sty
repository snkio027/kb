\newcommand{\ESDCover}[7]{%
  \begin{titlepage}
    \pagecolor{ESDAccentDark}\color{white}
    \begin{tikzpicture}[remember picture,overlay]
      \fill[ESDAccent] ($(current page.north west)+(0,-18mm)$) rectangle ($(current page.north east)+(0,-22mm)$);
      \draw[white,opacity=.12,line width=.45pt] ($(current page.north east)+(-82mm,-16mm)$) grid[xstep=9mm,ystep=9mm] ($(current page.south east)+(-1mm,18mm)$);
      \foreach \r in {0,1,2,3,4}{\draw[white,opacity={.10+.025*\r},line width=.7pt] ($(current page.south east)+(-16mm-8mm*\r,20mm+10mm*\r)$) circle[radius={11mm+4mm*\r}];}
      \fill[white,opacity=.9] ($(current page.south west)+(22mm,27mm)$) rectangle ($(current page.south west)+(54mm,28.4mm)$);
    \end{tikzpicture}
    \vspace*{14mm}
    {\sffamily\bfseries\fontsize{10}{12}\selectfont\MakeUppercase{#1}\par}
    \vspace{27mm}
    {\sffamily\bfseries\fontsize{30}{38}\selectfont\raggedright #2\par}
    \vspace{10mm}
    {\sffamily\fontsize{15}{22}\selectfont\color{white!78}\raggedright #3\par}
    \vfill
    \noindent\begin{tabularx}{\textwidth}{@{}>{\sffamily\bfseries\footnotesize}l X@{}}
      DOCUMENT & {\sffamily\small #4}\\[2mm]
      VERSION & {\sffamily\small #5}\\[2mm]
      STATUS & {\sffamily\small #6}\\[2mm]
      OWNER & {\sffamily\small #7}
    \end{tabularx}
    \vspace*{5mm}
  \end{titlepage}
  \nopagecolor\color{ESDInk}
}


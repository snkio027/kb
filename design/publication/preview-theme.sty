\newcommand{\PreviewID}{ESD · PREVIEW}
\newcommand{\PreviewVersion}{DRAFT}
\newcommand{\PreviewStatus}{DRAFT}
\newcommand{\PreviewSetIdentity}[3]{\gdef\PreviewID{#1}\gdef\PreviewVersion{#2}\gdef\PreviewStatus{#3}}
\pagestyle{fancy}\fancyhf{}
\fancyhead[L]{\sffamily\fontsize{8}{10}\selectfont\color{PreviewMuted}\PreviewID\quad v\PreviewVersion}
\fancyhead[R]{\sffamily\fontsize{8}{10}\selectfont\color{PreviewTeal}PREVIEW / DRAFT}
\fancyfoot[L]{\sffamily\fontsize{7.5}{9}\selectfont\color{PreviewMuted}\PreviewStatus}
\fancyfoot[R]{\sffamily\small\color{PreviewMuted}\thepage}
\renewcommand{\headrulewidth}{.3pt}
\fancypagestyle{plain}{\fancyhf{}\fancyhead[L]{\sffamily\fontsize{8}{10}\selectfont\PreviewID\quad v\PreviewVersion}\fancyhead[R]{\sffamily\fontsize{8}{10}\selectfont PREVIEW / DRAFT}\fancyfoot[L]{\sffamily\fontsize{7.5}{9}\selectfont\PreviewStatus}\fancyfoot[R]{\sffamily\small\thepage}}
\hypersetup{unicode=true,colorlinks=true,linkcolor=PreviewTeal,urlcolor=PreviewTeal,pdfdisplaydoctitle=true,bookmarksopen=false,pdflang={zh-CN}}
\urlstyle{same}
\DeclareRobustCommand{\PreviewInlineCode}[1]{\texttt{\seqsplit{#1}}}
\pdfstringdefDisableCommands{\def\PreviewInlineCode#1{#1}}
\makeatletter
\newcommand{\PreviewHeading}[3]{\par\Needspace{6\baselineskip}\hypertarget{#2}{}\csname #1\endcsname*{#3}\def\@currentHref{#2}\label{#2}\addcontentsline{toc}{#1}{#3}}
\makeatother
\providecommand{\tightlist}{\setlength{\itemsep}{1pt}\setlength{\parskip}{1pt}}

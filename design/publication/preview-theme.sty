\newtcolorbox{PreviewCodeBox}[1]{enhanced,breakable,colback=white,colframe=PreviewLine,colbacktitle=PreviewPaper,coltitle=PreviewMuted,fonttitle=\sffamily\fontsize{8}{10}\selectfont,title={#1 · 原文代码／流程},title after break={#1 · 续},boxrule=.3pt,arc=0pt,left=5pt,right=5pt,top=4pt,bottom=4pt,before skip=7pt,after skip=7pt}

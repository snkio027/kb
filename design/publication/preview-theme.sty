% Document boundaries start a page; source chapters may share a page.
\titleclass{\chapter}{straight}
\titleformat{\chapter}[block]{\sffamily\bfseries\color{PreviewNavy}\fontsize{23}{29}\selectfont}{}{0pt}{}
\titlespacing*{\chapter}{0pt}{22pt}{14pt}
